{
  "info": {
    "name": "ms-account-reservation clients API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "jwtToken",
      "value": "test-token"
    },
    {
      "key": "clientId",
      "value": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
    }
  ],
  "item": [
    {
      "name": "Clients",
      "item": [
        {
          "name": "Create client - 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "if (body.id) {",
                  "  pm.collectionVariables.set('clientId', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mdmId\": 1234567890,\n  \"firstName\": \"Ivan\",\n  \"lastName\": \"Petrov\",\n  \"middleName\": \"Sergeevich\",\n  \"citizenship\": \"RU\",\n  \"clientType\": \"PRIVATE\",\n  \"documentNumber\": \"123456\",\n  \"documentSeries\": \"AB\",\n  \"documentType\": \"PASSPORT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/clients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clients"
              ]
            }
          }
        },
        {
          "name": "Create client duplicate mdmId - 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', function () {",
                  "  pm.response.to.have.status(409);",
                  "});",
                  "pm.test('errorCode is CLIENT_MDM_ID_ALREADY_EXISTS', function () {",
                  "  pm.expect(pm.response.json().errorCode).to.eql('CLIENT_MDM_ID_ALREADY_EXISTS');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mdmId\": 1234567890,\n  \"firstName\": \"Ivan\",\n  \"lastName\": \"Petrov\",\n  \"middleName\": \"Sergeevich\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/clients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clients"
              ]
            }
          }
        },
        {
          "name": "Create client invalid body - 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "pm.test('errorCode is INVALID_CLIENT_DATA', function () {",
                  "  pm.expect(pm.response.json().errorCode).to.eql('INVALID_CLIENT_DATA');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mdmId\": 0,\n  \"firstName\": \"\",\n  \"lastName\": \"Petrov\",\n  \"middleName\": \"Sergeevich\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/clients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clients"
              ]
            }
          }
        },
        {
          "name": "Search clients - 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/clients?page=0&size=20&lastName=Petrov&mdmId=1234567890",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clients"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                },
                {
                  "key": "lastName",
                  "value": "Petrov"
                },
                {
                  "key": "mdmId",
                  "value": "1234567890"
                }
              ]
            }
          }
        },
        {
          "name": "Get client - 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/clients/{{clientId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clients",
                "{{clientId}}"
              ]
            }
          }
        },
        {
          "name": "Get client not found - 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', function () {",
                  "  pm.response.to.have.status(404);",
                  "});",
                  "pm.test('errorCode is CLIENT_NOT_FOUND', function () {",
                  "  pm.expect(pm.response.json().errorCode).to.eql('CLIENT_NOT_FOUND');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/clients/00000000-0000-0000-0000-000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clients",
                "00000000-0000-0000-0000-000000000000"
              ]
            }
          }
        },
        {
          "name": "Update client - 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ivan\",\n  \"lastName\": \"Petrov\",\n  \"middleName\": \"Sergeevich\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/clients/{{clientId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clients",
                "{{clientId}}"
              ]
            }
          }
        },
        {
          "name": "Client exists - 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/clients/{{clientId}}/exists",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clients",
                "{{clientId}}",
                "exists"
              ]
            }
          }
        },
        {
          "name": "Delete client - 204",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 204', function () {",
                  "  pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/clients/{{clientId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clients",
                "{{clientId}}"
